# Copy this file to .env and adjust the values for your machine.
# Environment variables already set in the shell override this file.

APP_NAME="Store API"
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
DATA_FILE=stores.json
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info
